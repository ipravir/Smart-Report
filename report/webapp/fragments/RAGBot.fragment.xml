<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:micro="sap.suite.ui.microchart"
    xmlns:layout="sap.ui.layout"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
>
    <Dialog
        id="feedDialog"
        title="Conversation with Report"
        contentWidth="45%"
        contentHeight="45%"
        resizable="true"
        draggable="true"
        titleAlignment="Center"
        verticalScrolling="false"
        horizontalScrolling="false">
        
        <content>
            <VBox height="100%" renderType="Bare">
                
                <!-- 1. SCROLLABLE CHAT MESSAGES CONTAINER -->
                <ScrollContainer
                    id="chatScrollContainer"
                    height="100%"
                    width="100%"
                    vertical="true"
                    horizontal="false"
                    class="sapUiResponsiveContentPadding">
                    <layoutData>
                        <FlexItemData growFactor="1" shrinkFactor="1" baseSize="0%" />
                    </layoutData>
                    
                    <!-- Updated Model and Property Path -->
                    <List
                        id="chatList"
                        showSeparators="None">
                        <CustomListItem class="sapUiSmallMarginBottom">
                            
                        </CustomListItem>
                    </List>
                </ScrollContainer>

                <!-- 2. FIXED BOTTOM FEED INPUT & CONTROL AREA -->
                <VBox class="sapUiSmallMargin">
                    <layoutData>
                        <FlexItemData growFactor="0" shrinkFactor="0" />
                    </layoutData>

                    <FeedInput
                        id="myFeedInput"
                        post="onPostFeedItem"
                        icon="sap-icon://employee"
                        placeholder="Query related to the current report data."
                        showIcon="true"
                        class="sapUiSmallMarginBottom"
                    />
                    <ObjectStatus
							class="sapUiSmallMarginBottom"
							text="Please note this output was generated by AI. It looks solid structurally, but please verify any critical facts or data points."
							icon="sap-icon://information"
							state="Information" />
                </VBox>
                	
            </VBox>
        </content>

        <buttons>
            <Button
                text="Close"
                type="Transparent"
                press="onCloseDialog"
            />
        </buttons>
    </Dialog>
</core:FragmentDefinition>