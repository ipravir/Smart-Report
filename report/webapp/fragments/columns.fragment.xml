<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="idSelectKeyDialog"
        title="Select Primary Key Fields"
        contentWidth="500px"
        contentHeight="400px"
        resizable="true"
        titleAlignment="Center"
        draggable="true">
        <content>

            <MessageStrip
                    text="Select at least one unique key field. Key fields are required to uniquely identify records and maintain data consistency during OpenSearch index operations."
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom" />

            <Table
                id="idColumnsTable"
                items="{temp>/columnsMetadata}"
                mode="None"
                sticky="HeaderToolbar,ColumnHeaders">
                <columns>
                    <Column width="3rem" hAlign="Center">
                        <Text text="Key" />
                    </Column>
                    <Column>
                        <Text text="Field Description" />
                    </Column>
                    <Column>
                        <Text text="Field Name" />
                    </Column>
                    <Column width="6rem">
                        <Text text="Type" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <!-- Checkbox bound to the local model isSelected attribute -->
                            <CheckBox selected="{temp>isSelected}" />
                            <ObjectStatus text="{temp>fieldDescription}" state="Information" />
                            <Text text="{temp>fieldName}" />
                            <Text text="{temp>type}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
        <beginButton>
            <Button
                text="Confirm"
                type="Emphasized"
                press=".onConfirmKeySelection" />
        </beginButton>
        <endButton>
            <Button
                text="Close"
                press=".onCloseDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>